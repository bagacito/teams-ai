# Server
PORT=3000
PUBLIC_BASE_URL=

# Internal OpenAI-compatible AI API
PDM_AI_BASE_URL=https://router.ai.pdmfc.com/v1
PDM_AI_API_KEY=
PDM_AI_MODEL=DeepSeek-V4.1-Flash

# Teams integration (local msteams-mcp adapter — browser-session auth, no
# Azure/Entra app registration). See README "Teams integration".
TEAMS_PROVIDER=msteams-mcp
# Absolute path to a local checkout of https://github.com/hickeroar/msteams-mcp
# (with `npm install` + `npm run build` done). Mounted into the container.
MSTEAMS_MCP_PATH=/opt/msteams-mcp
# Directory where the msteams-mcp browser session is stored (mounted volume,
# treated as sensitive credentials). The session lives at
# $MSTEAMS_SESSION_PATH/.teams-mcp-server — created by the manual login step.
MSTEAMS_SESSION_PATH=/app/teams-session
# Seconds between Teams polls (minimum recommended: 60; hard floor 15).
TEAMS_POLL_INTERVAL_SECONDS=60
TEAMS_POLL_MIN_INTERVAL_SECONDS=15
# Per-CLI-call timeout in ms.
MSTEAMS_MCP_TIMEOUT_MS=90000

# Admin UI
# Use a long random passphrase (min 16 chars). It is hashed at rest in DB.
ADMIN_PASSWORD=

# ntfy notifications
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_DETAIL_MODE=minimal

# Behavior
RECENT_MESSAGE_COUNT=20
SUMMARY_TRIGGER_MESSAGE_COUNT=40
DRAFT_EXPIRY_HOURS=12

# Logging: pino level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# Data directory (mounted volume in Docker)
DATA_DIR=./data
