# Server
PORT=3000
PUBLIC_BASE_URL=

# Internal OpenAI-compatible AI API
PDM_AI_BASE_URL=https://router.ai.pdmfc.com/v1
PDM_AI_API_KEY=
PDM_AI_MODEL=DeepSeek-V4.1-Flash

# Power Automate bridge
# Shared secret your inbound flow sends as: Authorization: Bearer <secret>
POWER_AUTOMATE_INBOUND_SECRET=
# HTTP-trigger flow URL + shared secret used to post APPROVED replies to Teams
POWER_AUTOMATE_OUTBOUND_URL=
POWER_AUTOMATE_OUTBOUND_SECRET=

# Admin UI
# Use a long random passphrase (min 16 chars). It is hashed at rest in DB.
ADMIN_PASSWORD=

# ntfy notifications
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_DETAIL_MODE=minimal

# Behavior
RECENT_MESSAGE_COUNT=20
SUMMARY_TRIGGER_MESSAGE_COUNT=40
DRAFT_EXPIRY_HOURS=12

# Logging: pino level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# Data directory (mounted volume in Docker)
DATA_DIR=./data
