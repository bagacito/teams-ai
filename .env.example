# Server
PORT=3000
PUBLIC_BASE_URL=https://teams-ai.example.com

# Internal OpenAI-compatible AI API
PDM_AI_BASE_URL=https://router.ai.org.com/v1
PDM_AI_API_KEY=
PDM_AI_MODEL=DeepSeek-V4.1-Flash

# Microsoft Entra ID (delegated auth)
MS_TENANT_ID=
MS_CLIENT_ID=
# Comma-separated Graph scopes
MS_GRAPH_SCOPES=Chat.ReadWrite,ChatMessage.Send,User.Read,offline_access

# Microsoft Graph subscriptions (webhooks)
# Only set if you want auto-create on boot; normally managed via /subscriptions UI
GRAPH_SUBSCRIPTION_MINUTES=55

# Admin UI
# Use a long random passphrase (min 16 chars). It is hashed at rest in DB.
ADMIN_PASSWORD=

# ntfy notifications
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_DETAIL_MODE=minimal

# Behavior
RECENT_MESSAGE_COUNT=20
SUMMARY_TRIGGER_MESSAGE_COUNT=40
DRAFT_EXPIRY_HOURS=12

# Logging: pino level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# Data directory (mounted volume in Docker)
DATA_DIR=./data
