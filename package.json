{
  "name": "teams-ai-assistant",
  "version": "0.1.0",
  "description": "Teams AI reply assistant with human-in-the-loop draft approval",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "auth": "node src/scripts/device-login.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "lint": "node --run lint 2>/dev/null || true"
  },
  "dependencies": {
    "@azure/msal-node": "^3.2.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.1.0",
    "openai": "^5.6.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
